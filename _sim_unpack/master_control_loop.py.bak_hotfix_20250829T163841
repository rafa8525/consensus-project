# --- begin: sms policy guardrails ---
import hashlib as _hashlib_guard
class SmsPolicy:
    def __init__(self, base_dir):
        from pathlib import Path
        self.base = Path(base_dir)
        self.ledger = self.base / "memory" / "logs" / "system" / "sms_ledger.jsonl"
        import os
        self.enabled = os.getenv("SMS_ENABLED","false").lower() == "true"
        self.whitelist = set([s.strip() for s in os.getenv("SMS_WHITELIST","").split(",") if s.strip()])
        self.quiet = os.getenv("SMS_QUIET_HOURS","21-08")
        self.max_per_hour = int(os.getenv("SMS_MAX_PER_HOUR","1"))
        self.max_per_day  = int(os.getenv("SMS_MAX_PER_DAY","2"))
        self.allow_voice  = os.getenv("ALLOW_VOICE_CALLS","false").lower() == "true"
        self.ledger.parent.mkdir(parents=True, exist_ok=True)
    def _now_local(self):
        from datetime import datetime
        return datetime.now()
    def _in_quiet_hours(self, now):
        try:
            start,end = self.quiet.split("-"); s,e = int(start), int(end); h = now.hour
            return (s<=h<=23 or 0<=h<e) if s>e else (s<=h<e)
        except Exception: return False
    def _hash_key(self, type_, to, subject=""):
        day = self._now_local().strftime("%Y-%m-%d")
        raw = f"{type_}|{to}|{subject}|{day}"
        return _hashlib_guard.sha256(raw.encode()).hexdigest()[:16]
    def _counts(self, to):
        per_hour=per_day=0
        now = self._now_local()
        hr_cut  = now.replace(minute=0, second=0, microsecond=0)
        day_cut = now.replace(hour=0, minute=0, second=0, microsecond=0)
        if self.ledger.exists():
            for line in self.ledger.open():
                try:
                    import json, datetime as _dtm
                    rec = json.loads(line)
                    if rec.get("to")!=to: continue
                    ts = _dtm.datetime.fromisoformat(rec["timestamp"])
                    if ts>=hr_cut: per_hour+=1
                    if ts>=day_cut: per_day+=1
                except Exception: pass
        return per_hour, per_day
    def _seen(self, key):
        if not self.ledger.exists(): return False
        for line in self.ledger.open():
            try:
                import json
                if json.loads(line).get("id")==key: return True
            except Exception: pass
        return False
    def should_send(self, type_, to, subject=""):
        if not self.enabled: return False, "SKIP_DISABLED"
        if self.whitelist and to not in self.whitelist: return False, "SKIP_NOT_WHITELISTED"
        if self._in_quiet_hours(self._now_local()): return False, "SKIP_QUIET_HOURS"
        ph,pd = self._counts(to)
        if ph>=self.max_per_hour: return False, "SKIP_RATE_HOURLY"
        if pd>=self.max_per_day:  return False, "SKIP_RATE_DAILY"
        key = self._hash_key(type_, to, subject)
        if self._seen(key): return False, "SKIP_DUPLICATE"
        return True, key
    def record(self, id_, to, body, status, meta=None):
        import json
        rec = {"timestamp": self._now_local().isoformat(timespec="seconds"),
            "id": id_, "to": to, "status": status, "body": (body or "")[:200],
            "meta": meta or {}}
        self.ledger.parent.mkdir(parents=True, exist_ok=True)
        with self.ledger.open("a") as f: f.write(json.dumps(rec)+"\n")
# --- end: sms policy guardrails ---
