# --- Secrets (never track) ---
memory/core/secrets/

# --- Environment files ---
.env

# --- Logs: ignore all by default, keep curated rollups ---
memory/logs/**
# Un-ignore parents so exceptions are seen
!memory/logs/
!memory/logs/system/
!memory/logs/reports/
!memory/logs/status/
# Keep curated rollups + contents
!memory/logs/system/agent_summaries/
!memory/logs/system/agent_summaries/**
!memory/logs/reports/
!memory/logs/reports/**
!memory/logs/status/
!memory/logs/status/**

# --- Typos / duplicate trees accidentally created by tools ---
memory/memory/**

# --- Backups, archives, misc dumps ---
archive/**/*
backups/**/*
backup/**/*
*.bak
*.bak_*
*.bak-*
*.tgz
*.tar
*.tar.gz
*.zip
agent_logs_*.tar*
reports/*_snapshot_*.zip
logs/**

# --- Python / OS ---
__pycache__/
*.pyc
.DS_Store
*.swp

# --- Explicit allow-list for audit rollups (tight rules) ---
!memory/logs/status/system_health_snapshot.md
!memory/logs/system/project_status_latest.md

# Evidence stays local, but allow README so GitHub shows intent
!memory/logs/evidence/
!memory/logs/evidence/README.md
