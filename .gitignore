# --- Secrets (never track) ---
memory/core/secrets/

# --- Logs: ignore all by default, keep curated rollups ---
memory/logs/**

# Un-ignore parents so exceptions are seen
!memory/logs/
!memory/logs/system/
!memory/logs/reports/
!memory/logs/status/

# Keep curated rollups + contents
!memory/logs/system/agent_summaries/
!memory/logs/system/agent_summaries/**
!memory/logs/reports/
!memory/logs/reports/**
!memory/logs/status/
!memory/logs/status/**

# Python / OS
__pycache__/
*.pyc
.DS_Store
*.swp
